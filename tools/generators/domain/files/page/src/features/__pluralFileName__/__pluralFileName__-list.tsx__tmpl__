"use client";

import { useLocale, useTranslations } from "next-intl";
import { Button, Card, CardContent, CardHeader, CardTitle, Input, Skeleton } from "@components";
import { formatDate } from "@utils";
import { use<%= pluralClassName %>List } from "./<%= pluralFileName %>-list.hook";

/** The <%= pluralFileName %> list: renders only; state and data come from the feature hook. */
export function <%= pluralClassName %>List() {
  const t = useTranslations("<%= pluralPropertyName %>");
  const common = useTranslations("common");
  const locale = useLocale();
  const { query, page, search, setSearch, setPage } = use<%= pluralClassName %>List();
  const list = query.data;
  const paginate = list?.getPaginate();

  return (
    <div className="container mx-auto max-w-5xl space-y-6 px-4 py-10">
      <header>
        <h1 className="text-2xl font-semibold">{t("title")}</h1>
        <p className="text-muted-foreground mt-1">{t("subtitle")}</p>
      </header>

      <Input
        value={search}
        onChange={(event) => setSearch(event.target.value)}
        placeholder={t("searchPlaceholder")}
        aria-label={common("search")}
        className="sm:max-w-xs"
      />

      {query.isPending ? (
        <div className="grid gap-4 sm:grid-cols-2" aria-busy="true">
          {Array.from({ length: 4 }).map((_, i) => (
            <Skeleton key={i} className="h-24" />
          ))}
        </div>
      ) : query.isError ? (
        <div role="alert" className="rounded-md border p-6 text-center">
          <p>{t("loadError")}</p>
          <Button variant="outline" className="mt-3" onClick={() => query.refetch()}>
            {common("retry")}
          </Button>
        </div>
      ) : !list || list.getItems().length === 0 ? (
        <p className="text-muted-foreground rounded-md border p-6 text-center">{t("empty")}</p>
      ) : (
        <ul className="grid gap-4 sm:grid-cols-2">
          {list.getItems().map((item) => (
            <li key={String(item.getId())}>
              <Card className="h-full">
                <CardHeader>
                  <CardTitle className="text-base">{item.getName()}</CardTitle>
                </CardHeader>
                <CardContent className="text-muted-foreground text-xs">
                  {t("created")}: {formatDate(item.getCreatedAt(), locale)}
                </CardContent>
              </Card>
            </li>
          ))}
        </ul>
      )}

      {paginate && paginate.getLastPage() > 1 ? (
        <nav className="flex items-center justify-between" aria-label="Pagination">
          <Button variant="outline" disabled={!paginate.getHasPreviousPage()} onClick={() => setPage(page - 1)}>
            {t("previous")}
          </Button>
          <span className="text-muted-foreground text-sm">
            {t("pageOf", { page: paginate.getCurrentPage(), total: paginate.getLastPage() })}
          </span>
          <Button variant="outline" disabled={!paginate.getHasNextPage()} onClick={() => setPage(page + 1)}>
            {t("next")}
          </Button>
        </nav>
      ) : null}
    </div>
  );
}
